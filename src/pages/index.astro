---
import { getCvData } from "../data/index";

const { profile } = getCvData("en");
const targetUrl = `${import.meta.env.BASE_URL}en/`;
const canonicalUrl = Astro.site ? new URL(targetUrl, Astro.site).toString() : targetUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${profile.name} - ${profile.title}`}</title>
    <meta name="description" content={profile.intro} />
    <link rel="canonical" href={canonicalUrl} />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <style>
      html,
      body {
        margin: 0;
        background: #f7f4ee;
      }
    </style>
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl + window.location.search + window.location.hash);
    </script>
  </head>
  <body></body>
</html>
