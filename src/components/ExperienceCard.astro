---
import { formatExperienceDuration } from "../data/index";
import type { Experience, Locale } from "../data/types";
import TagList from "./TagList.astro";

interface Props {
  experience: Experience;
  locale: Locale;
}

const { experience, locale } = Astro.props;
const getAssetHref = (path: string) =>
  path.startsWith("/") ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;
const compactPeriod = experience.period
  .replace(/^d['’]/i, "")
  .replace(/^de\s+/i, "")
  .replace(/^from\s+/i, "")
  .replace(/\s+(?:à|to)\s+/i, " → ");
const duration = formatExperienceDuration(experience.startDate, experience.endDate, locale);
---

<article class="experience-card">
  <div class="experience-main">
    <header class="experience-header">
      <div class="experience-logo-frame">
        <img
          class="experience-logo"
          src={getAssetHref(experience.logo.src)}
          alt={experience.logo.alt}
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="experience-heading">
        <h3>{experience.role}</h3>
        <p class="experience-meta">
          <span class="experience-company">{experience.company}</span>
          <span class="experience-location"> — {experience.location}</span>
          <span class="experience-period"> · {compactPeriod} ({duration})</span>
        </p>
        <p class="experience-kicker">{experience.context}</p>
      </div>
    </header>

    <ul class="experience-impact-list">
      {experience.impacts.map((impact) => <li>{impact}</li>)}
    </ul>

    {experience.stack.length > 0 && (
      <div class="experience-support">
        <TagList items={experience.stack} />
      </div>
    )}
  </div>
</article>
