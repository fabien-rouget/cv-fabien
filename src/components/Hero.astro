---
import type { ContactLink, Profile, UiLabels } from "../data/types";

interface Props {
  contactLinks: ContactLink[];
  profile: Profile;
  ui: UiLabels;
}

const { contactLinks, profile, ui } = Astro.props;
const getActionLabel = (link: ContactLink) => (link.label === "Email" ? ui.contactAction : link.value);
const getAriaLabel = (link: ContactLink) =>
  link.label === "Email" ? `${ui.contactActionAriaPrefix} ${link.value}` : link.value;
const getHref = (link: ContactLink) =>
  link.href.startsWith("/") ? `${import.meta.env.BASE_URL}${link.href.slice(1)}` : link.href;
const getAssetHref = (path: string) =>
  path.startsWith("/") ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;
const isPrimaryAction = (link: ContactLink) => link.label === "Email";
---

<header class="hero" id="top">
  <div class="hero-copy">
    <h1>{profile.name}</h1>
    <p class="hero-title">{profile.title}</p>
    <p class="hero-lead">{profile.heroSummary}</p>

    <div class="hero-actions">
      {contactLinks.map((link) => (
        <a
          class:list={["button", isPrimaryAction(link) ? "button-primary" : "button-secondary"]}
          href={getHref(link)}
          aria-label={getAriaLabel(link)}
          download={link.download}
          rel={link.external ? "noreferrer" : undefined}
          target={link.external ? "_blank" : undefined}
        >
          {link.label === "Email" && (
            <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="3" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          )}
          {link.label === "Linkedin" && (
            <svg class="button-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
            </svg>
          )}
          {link.label === "PDF" && (
            <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
          )}
          <span>{getActionLabel(link)}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="hero-photo-frame">
    <img
      class="hero-photo"
      src={getAssetHref(profile.photo.src)}
      alt={profile.photo.alt}
      width="400"
      height="400"
      loading="eager"
      decoding="async"
    />
  </div>
</header>
