---
import type { Locale } from "../data/types";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const { title, description, locale = "en" } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const enUrl = Astro.site ? new URL("/en/", Astro.site).toString() : undefined;
const frUrl = Astro.site ? new URL("/fr/", Astro.site).toString() : undefined;
const ogLocale = locale === "fr" ? "fr_FR" : "en_US";
const basePath = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#406f74" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {frUrl && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.toString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <link rel="icon" href={`${basePath}favicon.ico`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
